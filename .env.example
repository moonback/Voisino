# ─── Voisino — variables d'environnement ───────────────────────────────
# Copier ce fichier en `.env` puis compléter. Ne jamais committer `.env`.

# URL publique de l'application (sans slash final)
APP_URL=http://localhost:3000

# PostgreSQL + PostGIS (voir docker-compose.yml pour l'instance locale)
DATABASE_URL=postgres://voisino:voisino@localhost:5433/voisino
# Base dédiée aux tests d'intégration (créée automatiquement par `npm test`)
TEST_DATABASE_URL=postgres://voisino:voisino@localhost:5433/voisino_test

# Authentification (Better Auth). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── E-mails ──────────────────────────────────────────────────────────
# console : MODE DÉVELOPPEMENT — les e-mails ne sont PAS envoyés ; ils sont
#           écrits dans storage/dev-mail et consultables sur /dev/courrier.
# smtp    : envoi réel via SMTP_URL (ex. smtps://user:pass@smtp.example.com:465)
EMAIL_TRANSPORT=console
SMTP_URL=
EMAIL_FROM="Voisino <no-reply@example.com>"

# ─── Stockage des médias ──────────────────────────────────────────────
# local : fichiers sur disque dans STORAGE_DIR (développement / petit serveur)
# s3    : tout stockage compatible S3 (AWS S3, Cloudflare R2, Scaleway, MinIO…)
STORAGE_DRIVER=local
STORAGE_DIR=./storage/media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Traitement vidéo (FFmpeg) ────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Taille maximale d'un téléversement (Mo) et durée maximale (secondes)
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=180
# true : traite la file vidéo dans le serveur web juste après publication
# (pratique en local). En production, préférer `npm run worker` → false.
PROCESS_JOBS_INLINE=true
